# Copy to .env and adjust. Every variable is optional; the defaults in
# backend/app/core/config.py are used when a variable is absent.
# All variables are prefixed PDD_ (Plant Disease Detection).

# ---- paths ---------------------------------------------------------------
# Where the Kaggle dataset was downloaded. Leave unset to read the path that
# scripts/download_dataset.py recorded in data/dataset_path.json.
# PDD_DATASET_PATH=D:/data/new-plant-diseases-dataset
# PDD_UPLOAD_DIR=./uploads
# PDD_MODELS_DIR=./models
# PDD_ARTIFACTS_DIR=./artifacts

# ---- database ------------------------------------------------------------
# SQLite by default. Any SQLAlchemy URL works, e.g. postgresql+psycopg://...
# PDD_DATABASE_URL=sqlite:///./data/plant_disease.db

# ---- model serving -------------------------------------------------------
# "auto" resolves via models/exported/production.json; or name a model
# explicitly, e.g. efficientnet_b0_cbam.
PDD_SERVING_MODEL=auto
PDD_IMAGE_SIZE=224
# auto | cuda | cpu
PDD_DEVICE=auto

# ---- decision thresholds -------------------------------------------------
PDD_CONFIDENCE_HIGH=0.85
PDD_CONFIDENCE_MEDIUM=0.60
# Fallbacks used only when models/metadata/ood_thresholds.json is absent.
PDD_OOD_CONFIDENCE_FLOOR=0.45
PDD_OOD_ENTROPY_CEILING=0.55

# ---- image quality gates -------------------------------------------------
PDD_QUALITY_MIN_SIDE=64
PDD_QUALITY_BLUR_THRESHOLD=45.0
PDD_QUALITY_DARK_THRESHOLD=35.0
PDD_QUALITY_BRIGHT_THRESHOLD=225.0
PDD_QUALITY_MIN_SCORE=0.45
PDD_QUALITY_MIN_COHERENCE=0.50

# ---- uploads -------------------------------------------------------------
PDD_MAX_UPLOAD_SIZE=10485760
PDD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# ---- training ------------------------------------------------------------
PDD_SEED=42
PDD_BATCH_SIZE=32
PDD_LEARNING_RATE=0.0003
PDD_WEIGHT_DECAY=0.0001
PDD_NUM_WORKERS=4

# ---- API -----------------------------------------------------------------
PDD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PDD_LOG_LEVEL=INFO
