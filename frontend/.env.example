# Frontend configuration. Copy to .env.local to override.
#
# In development the Vite dev server proxies /api to the backend, so
# VITE_API_BASE_URL should stay empty and requests are same-origin.
#
# Set it only when the frontend is deployed separately from the API (for
# example a static bundle on Netlify pointing at a container-hosted backend).
# VITE_API_BASE_URL=https://api.example.com

# Where the dev-server proxy forwards /api. Change if the backend is not on 8000.
# VITE_API_TARGET=http://127.0.0.1:8000
